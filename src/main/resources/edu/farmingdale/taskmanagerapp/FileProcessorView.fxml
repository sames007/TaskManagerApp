<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="dropZone" alignment="CENTER" spacing="10" style="-fx-border-color: #cccccc; -fx-border-style: dashed; -fx-border-width: 2; -fx-padding: 20;" xmlns:fx="http://javafx.com/fxml" fx:controller="edu.farmingdale.taskmanagerapp.FileProcessorController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label fx:id="dropLabel" text="Drag and drop task file here" style="-fx-font-size: 16px;"/>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.farmingdale.taskmanagerapp.SignUpController">
   <children>
      <TextField fx:id="usernameField" layoutX="225.0" layoutY="174.0" promptText="Create username..." />
      <TextField fx:id="emailField" layoutX="225.0" layoutY="228.0" promptText="Enter email..." />
      <TextField fx:id="passwordField" layoutX="226.0" layoutY="280.0" promptText="Enter password..." />
      <Text layoutX="251.0" layoutY="105.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Create an Account" />
      <Button fx:id="createButton" layoutX="226.0" layoutY="332.0" mnemonicParsing="false" onAction="#createNewAccount" text="Create" />
      <Button layoutX="335.0" layoutY="332.0" mnemonicParsing="false" text="Back" />
   </children>
</AnchorPane>

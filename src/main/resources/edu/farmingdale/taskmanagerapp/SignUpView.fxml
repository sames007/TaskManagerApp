<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.farmingdale.taskmanagerapp.SignUpController"
      prefHeight="500.0" prefWidth="800.0" spacing="0" style="-fx-background-color: white;"
      stylesheets="@styling/styles.css">

    <!-- Left Panel: Form -->
    <VBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS" styleClass="login-pane">
        <padding><Insets top="50" bottom="50" left="50" right="50"/></padding>

        <ImageView fx:id="logoImage" fitHeight="40" fitWidth="40"/>
        <Text styleClass="title-text" text="Create an Account"/>
        <Text styleClass="subtitle-text" text="Sign up to manage your tasks seamlessly."/>

        <Label styleClass="form-label" text="Username"/>
        <TextField fx:id="usernameField" promptText="Create username..." styleClass="auth-field"/>

        <Label styleClass="form-label" text="Email"/>
        <TextField fx:id="emailField" promptText="Enter email..." styleClass="auth-field"/>

        <Label styleClass="form-label" text="Password"/>
        <PasswordField fx:id="passwordField" promptText="Enter password..." styleClass="auth-field"/>

        <Button fx:id="createButton" text="Create Account" styleClass="blue-button" onAction="#createNewAccount"/>

        <HBox alignment="CENTER">
            <Text text="Already have an account?"/>
            <Hyperlink fx:id="loginLink" text=" Log in"/>
        </HBox>
    </VBox>

    <!-- Right Panel: Illustration -->
    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: #6c63ff;">
        <ImageView fitHeight="400.0" fitWidth="340.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@images/signup.png"/>
            </image>
        </ImageView>
    </VBox>
</HBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.farmingdale.taskmanagerapp.ChatBoxController"
            prefWidth="600"
            prefHeight="700"
            styleClass="chat-container">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="chat-header">
            <padding>
                <Insets top="15" bottom="15" left="20" right="20"/>
            </padding>
            <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@images/chat-icon.png" />
            </ImageView>
            <Label text="Task Manager AI Assistant" styleClass="header-title"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="chat-scroll-pane">
            <VBox spacing="10" styleClass="chat-content-area">
                <padding>
                    <Insets top="10" bottom="10" left="15" right="15"/>
                </padding>
                <TextArea fx:id="chatArea"
                          editable="false"
                          wrapText="true"
                          VBox.vgrow="ALWAYS"
                          styleClass="chat-text-area"/>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="10" styleClass="input-container">
            <padding>
                <Insets top="15" bottom="20" left="20" right="20"/>
            </padding>
            <Label text="Ask me about task management, scheduling, or productivity tips!"
                   styleClass="input-hint"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="inputField"
                           promptText="Type your message here..."
                           HBox.hgrow="ALWAYS"
                           styleClass="input-field"/>
                <Button fx:id="sendButton"
                        minWidth="80"
                        text="Send"
                        styleClass="send-button"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
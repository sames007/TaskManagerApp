<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="500" prefWidth="800" style="-fx-background-color: #6c63ff;" stylesheets="@styling/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.farmingdale.taskmanagerapp.LoginController">

    <left>
        <VBox alignment="CENTER_LEFT" spacing="15" styleClass="login-pane">
            <padding><Insets bottom="50" left="50" right="50" top="50" /></padding>

            <ImageView fx:id="logoImage" fitHeight="40" fitWidth="40" />
            <Text styleClass="title-text" text="Welcome back!" />
            <Text styleClass="subtitle-text" text="Manage your tasks and stay organized with ease." />

            <Label styleClass="form-label" text="Email " />
            <TextField fx:id="emailTextField" promptText="Enter your mail address" styleClass="auth-field" />

            <Label styleClass="form-label" text="Password " />
            <TextField fx:id="passwordTextField" promptText="Enter password" styleClass="auth-field" />

            <HBox alignment="CENTER_LEFT" spacing="10">
                <CheckBox text="Remember me" />
                <Hyperlink text="Forgot your password?" />
            </HBox>

            <Button fx:id="loginButton" onAction="#login" styleClass="blue-button" text="Log In" />

            <HBox alignment="CENTER">
                <Text text="Don’t have an account?" />
                <Hyperlink text="Register here" />
            </HBox>

            <Button fx:id="backButton" onAction="#handleBack" styleClass="outline-button" text="Back" />
        </VBox>
    </left>

    <right>
        <Pane styleClass="login-right-pane">
         <children>
            <ImageView fitHeight="557.0" fitWidth="393.0" pickOnBounds="true">
               <image>
                  <Image url="@images/taskLoginImage.png" />
               </image>
            </ImageView>
         </children></Pane>
    </right>
</BorderPane>

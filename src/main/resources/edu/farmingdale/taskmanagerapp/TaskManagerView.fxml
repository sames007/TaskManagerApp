<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/19" fx:controller="edu.farmingdale.taskmanagerapp.TaskManagerController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>
    <HBox alignment="CENTER" spacing="10">
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Task Management System"/>
    </HBox>
    <HBox spacing="10">
        <TextField fx:id="taskInput" promptText="Enter task description" HBox.hgrow="ALWAYS" onAction="#addTask"/>
        <DatePicker fx:id="dueDatePicker" promptText="Due date"/>
        <HBox spacing="5">
            <Spinner fx:id="hourSpinner" prefWidth="60"/>
            <Label text=":" style="-fx-font-size: 16px; -fx-alignment: CENTER;"/>
            <Spinner fx:id="minuteSpinner" prefWidth="60"/>
            <ComboBox fx:id="amPmComboBox" prefWidth="80" promptText="AM/PM"/>
        </HBox>
        <ComboBox fx:id="priorityComboBox" promptText="Priority"/>
        <ComboBox fx:id="categoryComboBox" promptText="Category"/>
        <DatePicker fx:id="reminderDatePicker" promptText="Reminder Date"/>
        <Button onAction="#addTask" text="Add Task" defaultButton="true"/>
        <Button onAction="#editTask" text="Edit Task"/>
    </HBox>
    <HBox spacing="10" VBox.vgrow="ALWAYS">
        <TableView fx:id="taskTable" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="taskColumn" prefWidth="200" text="Task"/>
                <TableColumn fx:id="dueDateColumn" prefWidth="100" text="Due Date"/>
                <TableColumn fx:id="timeColumn" prefWidth="100" text="Time"/>
                <TableColumn fx:id="priorityColumn" prefWidth="100" text="Priority"/>
                <TableColumn fx:id="statusColumn" prefWidth="100" text="Status"/>
            </columns>
        </TableView>
        <fx:include source="FileProcessorView.fxml"/>
    </HBox>
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button onAction="#markTaskComplete" text="Mark Complete"/>
        <Button onAction="#deleteTask" text="Delete Task"/>
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="TOP_CENTER" prefHeight="540.0" prefWidth="460.0" spacing="14" styleClass="password-reset-pane" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.farmingdale.taskmanagerapp.ForgotPasswordController">
   <padding>
      <Insets bottom="28" left="36" right="36" top="32" />
   </padding>

   <Text styleClass="title-text" text="Forgot Password" />
   <Text styleClass="subtitle-text" text="Verify your security answer before setting a new password." wrappingWidth="360" />

   <Text styleClass="form-label" text="Email" />
   <HBox alignment="CENTER_LEFT" spacing="8">
      <TextField fx:id="emailField" HBox.hgrow="ALWAYS" promptText="Enter your email" styleClass="auth-field" />
      <Button fx:id="retrieveQuestionButton" mnemonicParsing="false" onAction="#retrieveQuestion" styleClass="secondary-button" text="Retrieve" />
   </HBox>

   <Text styleClass="form-label" text="Security Question" />
   <Text fx:id="securityQuestionText" styleClass="security-question-text" text="Enter your email to retrieve your security question." wrappingWidth="360" />

   <Text styleClass="form-label" text="Answer" />
   <HBox alignment="CENTER_LEFT" spacing="8">
      <TextField fx:id="answerField" HBox.hgrow="ALWAYS" promptText="Enter your answer" styleClass="auth-field" />
      <Button fx:id="verifyButton" mnemonicParsing="false" onAction="#verifyAnswer" styleClass="secondary-button" text="Verify" />
   </HBox>

   <Text fx:id="newPasswordText" styleClass="form-label" text="New Password" />
   <PasswordField fx:id="newPasswordField" maxWidth="Infinity" promptText="Enter new password" styleClass="auth-field" />

   <Text fx:id="confirmPasswordText" styleClass="form-label" text="Confirm New Password" />
   <PasswordField fx:id="confirmField" maxWidth="Infinity" promptText="Confirm new password" styleClass="auth-field" />

   <HBox alignment="CENTER_RIGHT" spacing="10">
      <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
      <Button fx:id="confirmButton" disable="true" mnemonicParsing="false" onAction="#confirmPassword" styleClass="blue-button" text="Confirm" />
   </HBox>
</VBox>

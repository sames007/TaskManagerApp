<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="520.0" prefWidth="295.0" spacing="10" style="-fx-padding: 10;" stylesheets="@styling/addTaskDialog.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.farmingdale.taskmanagerapp.AddTaskController">

    <Label styleClass="label-title" stylesheets="@styling/addTaskDialog.css" text="Task Description:" />
    <TextField fx:id="taskInput" promptText="Enter Task Description" />

    <Label styleClass="label-title" text="Due Date:" />
    <DatePicker fx:id="dueDatePicker" prefHeight="26.0" prefWidth="263.0" />

    <Label styleClass="label-title" text="Due Time:" />
    <HBox spacing="5">
        <Spinner fx:id="hourSpinner" prefHeight="26.0" prefWidth="72.0" />
        <Spinner fx:id="minuteSpinner" prefHeight="26.0" prefWidth="78.0" />
        <ComboBox fx:id="amPmComboBox" prefHeight="26.0" prefWidth="101.0" />
    </HBox>

    <Label styleClass="label-title" text="Priority:" />
    <ComboBox fx:id="priorityComboBox" onAction="#initialize" prefHeight="26.0" prefWidth="170.0" promptText="Select Priority" />

    <Label styleClass="label-title" text="Category:" />
    <ComboBox fx:id="categoryComboBox" onAction="#initialize" prefHeight="26.0" prefWidth="170.0" promptText="Select Category" />

    <Label styleClass="label-title" text="Reminder Date (Optional):" />
    <DatePicker fx:id="reminderDatePicker" prefHeight="26.0" prefWidth="263.0" />

    <Button fx:id="submitTaskButton" onAction="#submitTask" stylesheets="@styling/addTaskDialog.css" text="Add Task" translateX="1.0" />

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="575.0" prefWidth="320.0" spacing="12" style="-fx-padding: 15;" stylesheets="@styling/addTaskDialog.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.farmingdale.taskmanagerapp.AddTaskController">

    <Label styleClass="label-title" stylesheets="@styling/addTaskDialog.css" text="Task Description:" />
    <TextField fx:id="taskInput" promptText="Enter Task Description" />

    <Label styleClass="label-title" text="Due Date:" />
    <DatePicker fx:id="dueDatePicker" prefHeight="53.0" prefWidth="202.5" />

    <Label styleClass="label-title" text="Due Time:" />
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Spinner fx:id="hourSpinner" prefHeight="53.0" prefWidth="102.0" />
        <Spinner fx:id="minuteSpinner" prefHeight="53.0" prefWidth="102.0" />
        <ComboBox fx:id="amPmComboBox" prefWidth="85.0" />
    </HBox>

    <Label styleClass="label-title" text="Priority:" />
    <ComboBox fx:id="priorityComboBox" onAction="#initialize" prefWidth="202.5" promptText="Select Priority" />

    <Label styleClass="label-title" text="Category:" />
    <ComboBox fx:id="categoryComboBox" onAction="#initialize" prefWidth="202.5" promptText="Select Category" />

    <Label styleClass="label-title" text="Reminder Date (Optional):" />
    <DatePicker fx:id="reminderDatePicker" prefWidth="202.5" />

    <VBox alignment="CENTER">
        <Button fx:id="submitTaskButton" onAction="#submitTask" prefHeight="35.0" prefWidth="130.0" stylesheets="@styling/addTaskDialog.css" text="Add Task">
         <VBox.margin>
            <Insets top="5.0" />
         </VBox.margin></Button>
    </VBox>

</VBox>
